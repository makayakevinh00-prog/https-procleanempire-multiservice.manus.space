# Supabase (Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Clé service_role : UNIQUEMENT côté serveur (cron, synchro Qonto). Ne jamais préfixer par NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Qonto — soit un jeton OAuth (Bearer), soit la clé API historique (slug + clé secrète)
QONTO_ACCESS_TOKEN=
QONTO_ORGANIZATION_SLUG=
QONTO_SECRET_KEY=
# IBAN du compte à synchroniser (optionnel : sinon le compte principal)
QONTO_IBAN=

# Cron Vercel : secret envoyé en "Authorization: Bearer <CRON_SECRET>"
CRON_SECRET=

# E-mails (Resend) — facultatif : sans clé, aucun e-mail ne part
RESEND_API_KEY=
MAIL_FROM="ProClean Empire <contact@procleanempire.com>"
